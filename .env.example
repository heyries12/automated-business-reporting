SERVICE_API_KEY=replace-with-a-long-random-value

# Optional for /v1/reports/generate. The Google Sheets workflow uses
# /v1/reports/generate-from-records and does not need these REST source settings.
BUSINESS_API_BASE_URL=https://api.example.com/v1
BUSINESS_API_PATH=/orders
BUSINESS_API_TOKEN=replace-with-business-api-token
BUSINESS_API_KEY_HEADER=
BUSINESS_API_KEY_VALUE=
BUSINESS_API_DATE_FROM_PARAM=start_date
BUSINESS_API_DATE_TO_PARAM=end_date
BUSINESS_API_RECORDS_PATH=data
BUSINESS_API_TIMEOUT_SECONDS=30
REPORT_GENERATION_TIMEOUT_SECONDS=150

# Leave BUSINESS_API_PAGE_PARAM blank for a non-paginated endpoint.
BUSINESS_API_PAGE_PARAM=
BUSINESS_API_PAGE_SIZE_PARAM=limit
BUSINESS_API_PAGE_SIZE=100
BUSINESS_API_MAX_PAGES=20

# Dot paths are supported, for example customer.id or totals.grand_total.
REPORT_DATE_FIELD=created_at
REPORT_AMOUNT_FIELD=amount
REPORT_STATUS_FIELD=status
REPORT_CUSTOMER_FIELD=customer_id
REPORT_CATEGORY_FIELD=category
REPORT_SUCCESS_STATUSES=paid,completed,fulfilled
REPORT_CURRENCY=USD
REPORT_MAX_RECORDS=10000

AI_ENABLED=true
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
