{
  "name": "Automated Daily Business Reporting",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "7a8265e1-a0a1-47a4-889e-c0a31a9bb101",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-900, 180]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const reportName = 'Daily Business Report';\nconst recipientEmail = 'REPLACE_WITH_REPORT_RECIPIENT@example.com';\n\nconst now = new Date();\nconst periodEnd = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));\nconst periodStart = new Date(periodEnd.getTime() - 24 * 60 * 60 * 1000);\n\nreturn [{\n  json: {\n    report_name: reportName,\n    recipient_email: recipientEmail,\n    period_start: periodStart.toISOString(),\n    period_end: periodEnd.toISOString(),\n  },\n}];"
      },
      "id": "7a8265e1-a0a1-47a4-889e-c0a31a9bb102",
      "name": "Build Daily Period",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-660, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://reporting-api:8000/v1/reports/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ report_name: $json.report_name, period_start: $json.period_start, period_end: $json.period_end }) }}",
        "options": {
          "timeout": 360000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "7a8265e1-a0a1-47a4-889e-c0a31a9bb103",
      "name": "Generate Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [-410, 180]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const report = $json;\nconst required = ['report_key', 'email_subject', 'email_html', 'sheet_row', 'summary_mode'];\nfor (const field of required) {\n  if (report[field] === undefined || report[field] === null || report[field] === '') {\n    throw new Error(`Report response is missing ${field}`);\n  }\n}\n\nconst row = report.sheet_row;\nif (row.report_key !== report.report_key) {\n  throw new Error('Report and Sheet row keys do not match');\n}\nfor (const field of ['total_revenue', 'total_transactions', 'completed_transactions', 'average_order_value', 'unique_customers']) {\n  if (typeof row[field] !== 'number' || !Number.isFinite(row[field])) {\n    throw new Error(`Invalid numeric field: ${field}`);\n  }\n}\nif (!String(report.email_html).toLowerCase().includes('<html')) {\n  throw new Error('Report email_html is not an HTML document');\n}\n\nreturn { json: report };"
      },
      "id": "7a8265e1-a0a1-47a4-889e-c0a31a9bb104",
